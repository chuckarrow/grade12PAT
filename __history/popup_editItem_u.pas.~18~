unit popup_editItem_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Samples.Spin, Vcl.StdCtrls, Vcl.ComCtrls, DMUnit, DMCommon_u, DB, System.UITypes;

type
  TEditMode = (emEdit, emAdd);

  TfrmEditItem = class(TForm)
    edtName: TEdit;
    redDescription: TRichEdit;
    edtMaterial: TEdit;
    edtPrice: TEdit;
    sedQuantity: TSpinEdit;
    sedSale: TSpinEdit;
    lbl01: TLabel;
    edtStockPrice: TEdit;
    btnReset: TButton;
    btnUpdate: TButton;
    procedure FormShow(Sender: TObject);
    procedure btnResetClick(Sender: TObject);
    procedure refreshData();
    procedure btnUpdateClick(Sender: TObject);
    function getNextID(const TableName, IDField, Prefix: string): string;
    procedure addUser();
    procedure updateUser();
    procedure clearFields();
  private
    FMode: TEditMode;
    FAddStoreID: string; // store_id to attach new stock to, only used in emAdd mode
  public
    procedure ShowForEdit;
    procedure ShowForAdd(const AStoreID: string);
  end;

var
  frmEditItem: TfrmEditItem;

implementation

uses
  manager_home_u;
{$R *.dfm}

{ Public entry points }

procedure TfrmEditItem.ShowForEdit;
begin
  FMode := emEdit;
  Show;
end;

procedure TfrmEditItem.ShowForAdd(const AStoreID: string);
begin
  FMode := emAdd;
  FAddStoreID := AStoreID;
  Show;
end;

{ Form }

procedure TfrmEditItem.FormShow(Sender: TObject);
begin
  if FMode = emEdit then
    refreshData
  else
  begin
    clearFields;
    btnUpdate.Caption := 'Add';
  end;
end;

procedure TfrmEditItem.clearFields;
begin
  edtName.Text := '';
  redDescription.Text := '';
  edtMaterial.Text := '';
  edtPrice.Text := '';
  edtStockPrice.Text := '';
  sedQuantity.Value := 0;
  sedSale.Value := 0;
end;

procedure TfrmEditItem.addUser;
var
  qItems, qStock, newItemID, newStockID: string;
begin
  // Basic validation
  if (Trim(edtName.Text) = '') or (Trim(edtPrice.Text) = '') then
  begin
    ShowMessage('Item name and price are required.');
    Exit;
  end;

  newItemID := getNextID('tblItems', 'item_id', 'IT');
  newStockID := getNextID('tblStock', 'stock_id', 'ST');

  // NOTE: use FAddStoreID (captured when the form was opened for adding),
  // NOT the manager grid's currently selected row - that row may not exist
  // or may refer to a different item entirely.
  qItems := 'INSERT INTO tblItems (item_id, item_name, item_description, material, price, sale) ' +
    'VALUES (' + QuotedStr(newItemID) + ', ' +
    QuotedStr(edtName.Text) + ', ' +
    QuotedStr(redDescription.Text) + ', ' +
    QuotedStr(edtMaterial.Text) + ', ' +
    edtPrice.Text + ', ' +
    IntToStr(sedSale.Value) + ')';

  qStock := 'INSERT INTO tblStock (stock_id, store_id, item_id, quantity_available, stock_price) ' +
    'VALUES (' + QuotedStr(newStockID) + ', ' +
    QuotedStr(FAddStoreID) + ', ' +
    QuotedStr(newItemID) + ', ' +
    IntToStr(sedQuantity.Value) + ', ' +
    edtStockPrice.Text + ')';

  DMUnit.DataModule1.RunSQL(qItems);
  DMUnit.DataModule1.RunSQL(qStock);

  ShowMessage('Item added successfully.');
  manager_home_u.frmManagerHome.DBGrid1.DataSource.DataSet.Refresh;
  Close;
end;

procedure TfrmEditItem.updateUser;
var
  qItems, qStock, itemID, storeID: string;
begin
  // Get keys from the currently selected row in the manager grid
  itemID := manager_home_u.frmManagerHome.DBGrid1.DataSource.DataSet.FieldByName('item_id').AsString;
  storeID := manager_home_u.frmManagerHome.DBGrid1.DataSource.DataSet.FieldByName('store_id').AsString;

  qItems := 'UPDATE tblItems SET ' +
    'item_name = ' + QuotedStr(edtName.Text) + ', ' +
    'item_description = ' + QuotedStr(redDescription.Text) + ', ' +
    'material = ' + QuotedStr(edtMaterial.Text) + ', ' +
    'price = ' + edtPrice.Text + ', ' +
    'sale = ' + IntToStr(sedSale.Value) + ' ' +
    'WHERE item_id = ' + QuotedStr(itemID);

  qStock := 'UPDATE tblStock SET ' +
    'quantity_available = ' + IntToStr(sedQuantity.Value) + ', ' +
    'stock_price = ' + edtStockPrice.Text + ' ' +
    'WHERE item_id = ' + QuotedStr(itemID) + ' ' +
    'AND store_id = ' + QuotedStr(storeID);

  DMUnit.DataModule1.RunSQL(qItems);
  DMUnit.DataModule1.RunSQL(qStock);   // <-- was qItems again in the original, bug fixed

  ShowMessage('Item updated successfully.');
  manager_home_u.frmManagerHome.DBGrid1.DataSource.DataSet.Refresh;
  Close;
end;

{ Buttons }

procedure TfrmEditItem.btnResetClick(Sender: TObject);
begin
  if MessageDlg('Are you sure you want to RESET fields?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
  begin
    if FMode = emEdit then
      refreshData
    else
      clearFields;
  end;
end;

procedure TfrmEditItem.btnUpdateClick(Sender: TObject);
begin
  if FMode = emAdd then
    addUser
  else
    updateUser;
end;

{ Custom Methods }

procedure TfrmEditItem.refreshData;
var
  q: string;
  ds: TDataSet;
begin
  q := 'SELECT i.item_id, i.item_name, i.item_description, i.material, i.price, i.sale, ' +
    's.stock_id, s.store_id, s.quantity_available, s.stock_price ' +
    'FROM tblItems i INNER JOIN tblStock s ON i.item_id = s.item_id ' +
    'WHERE s.item_id = ' + QuotedStr(manager_home_u.frmManagerHome.DBGrid1.DataSource.DataSet.FieldByName('item_id').AsString);
  DMUnit.DataModule1.RunSQL(q);

  ds := DMUnit.DataModule1.dsQrySQL.DataSet;

  if not ds.IsEmpty then
  begin
    edtName.Text := ds.FieldByName('item_name').AsString;
    redDescription.Text := ds.FieldByName('item_description').AsString;
    edtMaterial.Text := ds.FieldByName('material').AsString;
    edtPrice.Text := ds.FieldByName('price').AsString;
    edtStockPrice.Text := ds.FieldByName('stock_price').AsString;
    sedQuantity.Value := ds.FieldByName('quantity_available').AsInteger;
    sedSale.Value := ds.FieldByName('sale').AsInteger;
    btnUpdate.Caption := 'Update';
  end
  else
  begin
    clearFields;
    btnUpdate.Caption := 'Add';
  end;
end;

function TfrmEditItem.getNextID(const TableName, IDField, Prefix: string): string;
var
  ds: TDataSet;
  q: string;
  maxNum: integer;
begin
  q := 'SELECT MAX(' + IDField + ') AS MaxID FROM ' + TableName;
  DMUnit.DataModule1.RunSQL(q);
  ds := DMUnit.DataModule1.dsQrySQL.DataSet;

  if not ds.IsEmpty and (ds.FieldByName('MaxID').AsString <> '') then
    maxNum := StrToIntDef(Copy(ds.FieldByName('MaxID').AsString, Length(Prefix) + 1), 0)
  else
    maxNum := 0;

  Result := Prefix + Format('%.3d', [maxNum + 1]);
end;

end.
