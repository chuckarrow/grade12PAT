unit DMLoginSystem_u;

interface

uses
  System.SysUtils, System.Classes, VCL.Forms, DMUnit, Data.DB, utils_u;

procedure openHome(username: string; form: TForm);

type
  // --- SIGNUP OBJECT ---
  TUserSignup = class(TObject)
  private
    FName: string;
    FSurname: string;
    FUsername: string;
    FPassword: string;
    FPasswordRetype: string;
    FAge: Integer;
    FGender: Boolean;
  public
    constructor CreateNew(const AName, ASurname, AUsername, APassword,
      APasswordRetype: string; AAge: Integer; AGender: Boolean);
    function PasswordsMatch: Boolean;
    function IsPasswordSecure: Boolean;
    function IsAgeValid: Boolean;
    function UserExistsInDB: Boolean;
    function IsUsernameValid: Boolean;
    function AttemptRegister(out ErrorMsg: string): Boolean; // Master check
  end;

  // --- LOGIN OBJECT ---
  TUserLogin = class(TObject)
  private
    FUsername: string;
    FPassword: string;
  public
    constructor CreateNew(const AUsername, APassword: string);
    function CredentialsAreValid: Boolean;
    function VerifyAgainstDB: Boolean;
    function Authenticate(out ErrorMsg: string): Boolean; // Master check

    function getUsername(): string;
    function getName(): string;
    function getBalance(): Currency;
  end;

  TDM2 = class(TDataModule)
  private
    { Private declarations }
  public
    { Public declarations }
    CurrentUserSignup: TUserSignup; // TODO: is needed;  find uses?
    CurrentUserLogin: TUserLogin; // Reference for active login attempt
  end;

var
  DM2: TDM2;
  currUser: TUserLogin; // Change to signup

implementation

uses
  home_u, manager_home_u, admin_home_u;

{%CLASSGROUP 'Vcl.Controls.TControl'}
{$R *.dfm}

{ =========== }
{ TUserSignup }
{ =========== }

// Constructor
constructor TUserSignup.CreateNew(const AName, ASurname, AUsername, APassword,
  APasswordRetype: string; AAge: Integer; AGender: Boolean);
begin
  inherited Create;
  FName := AName;
  FSurname := ASurname;
  FUsername := AUsername;
  FPassword := APassword;
  FPasswordRetype := APasswordRetype;
  FAge := AAge;
  FGender := AGender;
end;

// Password Match (Bool)
// Check if passwords are NOT empty and DO match.
function TUserSignup.PasswordsMatch: Boolean;
begin
  Result := (FPassword <> '') and (FPassword = FPasswordRetype);
end;

// Password Security (Bool)
// Check if the password is secure.
function TUserSignup.IsPasswordSecure: Boolean;
var
  HasUpper, HasLower, HasDigit: Boolean;
  C: Char;
begin
  if Length(FPassword) < 8 then
    Exit(False);

  HasUpper := False;
  HasLower := False;
  HasDigit := False;

  for C in FPassword do
  begin
    if CharInSet(C, ['A' .. 'Z']) then
      HasUpper := True;
    if CharInSet(C, ['a' .. 'z']) then
      HasLower := True;
    if CharInSet(C, ['0' .. '9']) then
      HasDigit := True;
  end;

  Result := HasUpper and HasLower and HasDigit;
end;

function TUserSignup.IsAgeValid: Boolean;
begin
  Result := (FAge >= 13) and (FAge <= 120);
end;

function TUserSignup.UserExistsInDB: Boolean;
var
  q: string;
begin
  q := 'SELECT Password FROM tblUsers WHERE username = "' + FUsername + '" ';

  DMUnit.DataModule1.RunSQL(q);
  Result := not DMUnit.DataModule1.qrySQL.IsEmpty;

end;

function TUserSignup.IsUsernameValid: Boolean;
begin
  Result := (Length(FUsername) >= 3) and (Pos(' ', FUsername) = 0);
end;

function TUserSignup.AttemptRegister(out ErrorMsg: string): Boolean;
var
  q: string;
begin
  ErrorMsg := '';
  Result := False; // Default to False

  if (FName = '') or (FSurname = '') then
    ErrorMsg := 'Name and Surname cannot be empty.'
  else if not IsUsernameValid then
    ErrorMsg := 'Username must be at least 3 characters and contain no spaces.'
  else if UserExistsInDB then
    ErrorMsg := 'This username is already taken.'
  else if not PasswordsMatch then
    ErrorMsg := 'Passwords do not match.'
  else if not IsPasswordSecure then
    ErrorMsg :=
      'Password must be at least 8 characters, with uppercase, lowercase, and numbers.'
  else if not IsAgeValid then
    ErrorMsg := 'You must be at least 13 years old to register.'
  else
  begin
    q := 'INSERT INTO tblUsers ([username], [password], [name], [surname], [acc_type], [balance], [isMale]) ' +
      'VALUES (' +
      QuotedStr(FUsername) + ', ' +
      QuotedStr(FPassword) + ', ' +
      QuotedStr(FName) + ', ' +
      QuotedStr(FSurname) + ', ' +
      '1, ' + // Default account type
      QuotedStr(FloatToStr(utils_u.startingCurrency)) + ', ' +
      BoolToStr(FGender, True) + ')';

    // Execute Query
    with DMUnit.DataModule1 do
    begin
      qrySQL.Close;
      qrySQL.SQL.Text := q;
      qrySQL.ExecSQL;
    end;

    currUser := TUserLogin.CreateNew(FUsername, FPassword);
    Result := True;
  end;
end;

{ ================== }
{ End of TUserSignup }
{ ================== }

{ ========== }
{ TUserLogin }
{ ========== }

constructor TUserLogin.CreateNew(const AUsername, APassword: string);
begin
  inherited Create;
  FUsername := Trim(AUsername);
  FPassword := APassword;
end;

// Get username
function TUserLogin.getUsername(): string;
begin
  Result := FUsername;
end;

// Get Name
function TUserLogin.getName(): string;
var
  q: string;
begin

  q := 'SELECT name FROM tblUsers WHERE username = "' + FUsername + '" ';
  DMUnit.DataModule1.RunSQL(q);

  Result := DMUnit.DataModule1.qrySQL.FieldByName('name').AsString;
end;

// Get Balance
function TUserLogin.getBalance: Currency;
var
  q: string;
begin
  q := 'SELECT balance FROM tblUsers WHERE username = "' + FUsername + '" ';
  DMUnit.DataModule1.RunSQL(q);

  Result := DMUnit.DataModule1.qrySQL.FieldByName('balance').AsCurrency;
end;

// Valid Credentials
function TUserLogin.CredentialsAreValid: Boolean;
begin
  Result := (FUsername <> '') and (FPassword <> '');
end;

function TUserLogin.VerifyAgainstDB: Boolean;
var
  q: string;
begin

  q := 'SELECT Password FROM tblUsers WHERE username = "' + FUsername + '" ';

  with DMUnit.DataModule1 do
  begin
    RunSQL(q); // (SELECT ONLY)

    qrySQL.Close;
    qrySQL.SQL.Text := q;
    qrySQL.Open;

    if qrySQL.FieldByName('Password').AsString = FPassword then
      Result := True
    else
      Result := False;
    qrySQL.Close;
  end;
end;

function TUserLogin.Authenticate(out ErrorMsg: string): Boolean;
begin
  ErrorMsg := '';
  Result := False;

  if not CredentialsAreValid then
    ErrorMsg := 'Username and Password fields cannot be blank.'
  else if not VerifyAgainstDB then
    ErrorMsg := 'Invalid username or password.'
  else
  begin
    currUser := TUserLogin.CreateNew(FUsername, FPassword);
    Result := True; // Access granted
  end;

end;

{ All }
procedure openHome(username: string; form: TForm);
var
  q: string;
  accType: Integer;
begin
  q := 'SELECT acc_type FROM tblUsers WHERE username = "' + username + '" ';
  with DMUnit.DataModule1 do
  begin
    RunSQL(q); // (SELECT ONLY)

    qrySQL.Close;
    qrySQL.SQL.Text := q;
    qrySQL.Open;

    accType := qrySQL.FieldByName('acc_type').AsInteger;

    qrySQL.Close;
  end;

  form.hide;
  if accType = 1 then // User
  begin
    home_u.frmHome.show;
  end
  else if accType = 2 then // Manager
  begin
    manager_home_u.frmManagerHome.show;
  end
  else if (accType = 3) OR (accType = 4) then // Admin / SuperAdmin
  begin
    admin_home_u.frmAdminHome.show;
  end;

end;

end.
