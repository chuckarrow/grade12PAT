unit admin_home_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Data.DB, Vcl.Grids, Vcl.DBGrids, Vcl.StdCtrls, DMUnit, utils_u, Vcl.WinXCtrls,
  System.UITypes,
  DMLoginSystem_u;

type
  TfrmAdminHome = class(TForm)
    DBGrid1: TDBGrid;
    btnAdd: TButton;
    btnEdit: TButton;
    btnDelete: TButton;
    btnSignout: TButton;
    grpEditor: TGroupBox;
    btnClear: TButton;
    edtName: TEdit;
    edtUsername: TEdit;
    edtSurname: TEdit;
    cmbAccType: TComboBox;
    edtBalance: TEdit;
    tgsGender: TToggleSwitch;
    lbl01: TLabel;
    edtPassword: TEdit;
    procedure refreshUsers();
    procedure FormShow(Sender: TObject);
    procedure btnSignoutClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnEditClick(Sender: TObject);
    procedure warnUnsaved(Sender: TObject);
    procedure btnDeleteClick(Sender: TObject);
    procedure setEditorWarn(i: integer);
    procedure btnClearClick(Sender: TObject);
    procedure edtUsernameChange(Sender: TObject);
    procedure btnAddClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

type
  TSaveState = record
    Description: String;
    Colour: TColor;
  end;

var
  frmAdminHome: TfrmAdminHome;
  doesUserExist: boolean;

const
  SAVE_STATE: array [0 .. 3] of TSaveState = (
    (Description: ''; Colour: clBlack),
    (Description: 'Unsaved Changes'; Colour: clRed),
    (Description: 'User Deleted'; Colour: clGray),
    (Description: 'User Found'; Colour: clBlack)
    );

implementation

uses
  launch_welcome_u;

{$R *.dfm}


// Show Form
procedure TfrmAdminHome.FormShow(Sender: TObject);
begin
  refreshUsers;
end;

// Close Form
procedure TfrmAdminHome.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caNone;
  utils_u.confirmQuit;
end;

// Signout Button
procedure TfrmAdminHome.btnSignoutClick(Sender: TObject);
begin
  self.hide;
  launch_welcome_u.frmWelcome.show;
end;

procedure TfrmAdminHome.edtUsernameChange(Sender: TObject);
var
  q: string;
begin
  warnUnsaved(self);
  q := 'SELECT username FROM tblUsers WHERE username = ' + QuotedStr(edtUsername.Text);
  DMUnit.DataModule1.RunSQL(q);
  if DBGrid1.DataSource.DataSet.RecordCount > 0 then
  begin
    doesUserExist := true;
    setEditorWarn(3);
    btnAdd.Caption := 'Update User';
  end
  else
  begin
    doesUserExist := false;
    setEditorWarn(1);
    btnAdd.Caption := 'Add User';
  end;

  refreshUsers;
end;

procedure TfrmAdminHome.refreshUsers;
var
  q: string;
begin

  // Populate Grid With Stores of Logged in Manager
  q := 'SELECT * FROM tblUsers ';
  DMUnit.DataModule1.RunSQL(q);
  DBGrid1.DataSource := DMUnit.DataModule1.dsQrySQL;
end;

procedure TfrmAdminHome.setEditorWarn(i: integer);
begin
  lbl01.Caption := SAVE_STATE[i].Description;
  lbl01.Font.Color := SAVE_STATE[i].Colour;
end;

procedure TfrmAdminHome.warnUnsaved(Sender: TObject);
begin
  setEditorWarn(1);
end;

// Clear Button
procedure TfrmAdminHome.btnClearClick(Sender: TObject);
begin
  edtUsername.Clear;
  edtName.Clear;
  edtSurname.Clear;
  cmbAccType.Refresh;
  edtBalance.Clear;
  tgsGender.State := tssOn;

  setEditorWarn(0);
end;

procedure TfrmAdminHome.btnAddClick(Sender: TObject);
var
  q, sBalance: string;
begin

  sBalance := StringReplace(edtBalance.Text, ',', '.', [rfReplaceAll]);
  sBalance := StringReplace(sBalance, ' ', '', [rfReplaceAll]);

  if doesUserExist then
  begin
    q := 'UPDATE tblUsers SET ' +
      'update = ' + QuotedStr(edtPassword.Text) + ', ' +
      'name = ' + QuotedStr(edtName.Text) + ', ' +
      'surname = ' + QuotedStr(edtSurname.Text) + ', ' +
      'acc_type = ' + IntToStr(cmbAccType.ItemIndex + 1) + ', ' +
      'balance = ' + sBalance + ', ' +
      'is_male = ' + BoolToStr(tgsGender.State = tssOn, true) +
      ' WHERE Username = ' + QuotedStr(edtUsername.Text);
    DMUnit.DataModule1.ExecuteSQL(q);
    ShowMessage('Successfully updated');
  end
  else
  begin
    q := 'INSERT INTO tblUsers (Username, password, name, surname, acc_type, balance, is_male) ' +
      'VALUES (' + QuotedStr(edtUsername.Text) + ', ' +
      QuotedStr(edtPassword.Text) + ', ' +
      QuotedStr(edtName.Text) + ', ' +
      QuotedStr(edtSurname.Text) + ', ' +
      IntToStr(cmbAccType.ItemIndex + 1) + ', ' +
      sBalance + ', ' +
      BoolToStr(tgsGender.State = tssOn, true) + ')';
    DMUnit.DataModule1.ExecuteSQL(q);
    ShowMessage('Successfully added');
  end;

  refreshUsers;
end;

procedure TfrmAdminHome.btnDeleteClick(Sender: TObject);
var
  q, sUser: string;
begin

  sUser := QuotedStr(DBGrid1.DataSource.DataSet.FieldByName('username').AsString);

  // Ensure current admin cannot be deleted
  if DBGrid1.DataSource.DataSet.FieldByName('username').AsString = currUser.getUsername then
  begin
    ShowMessage('You cannot delete your own account!');
    Exit;
  end;

  // Check if mamanger, and if they have stores
  if DBGrid1.DataSource.DataSet.FieldByName('acc_type').AsInteger = 2 then
  begin
    ShowMessage
      ('This is a manager!'#13#10'This service does not allow deleting of managers.'#13#10'Recommended Action:'#13#10#13#10'Create new Account & Migrate Stores to new manager accountd');
    Exit;
  end;

  // Confirm Deletion
  if MessageDlg('You are about to delete this user!'#13#10'This action CANNOT be undone'#13#10'Continue?',
    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
    Exit;

  // User
  q := 'DELETE FROM tblTrip WHERE username = ' + sUser;
  DMUnit.DataModule1.ExecuteSQL(q);

  q := 'DELETE FROM tblUsers WHERE username = ' + sUser;
  DMUnit.DataModule1.ExecuteSQL(q);

  // GUI
  setEditorWarn(2);
  refreshUsers;
end;

// Edit User Button
procedure TfrmAdminHome.btnEditClick(Sender: TObject);
var
  ds: TDataSet;
  sUsername, spassword, sName, sSurname, sBalance: string;
  iAccType: integer;
  bIsMale: boolean;
begin

  if (lbl01.Caption = 'Unsaved Changes') then
    if MessageDlg('You have unsaved Changes! '#13#10'Continue?',
      mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
      Exit;

  ds := DBGrid1.DataSource.DataSet;

  // Create Snapshot
  sUsername := ds.FieldByName('Username').AsString;
  spassword := ds.FieldByName('password').AsString;
  sName := ds.FieldByName('name').AsString;
  sSurname := ds.FieldByName('surname').AsString;
  iAccType := ds.FieldByName('acc_type').AsInteger - 1;
  sBalance := ds.FieldByName('balance').AsString;
  bIsMale := ds.FieldByName('is_male').AsBoolean;

  edtUsername.Text := sUsername;
  edtPassword.Text := spassword;
  edtName.Text := sName;
  edtSurname.Text := sSurname;
  cmbAccType.ItemIndex := iAccType;
  edtBalance.Text := sBalance;
  if bIsMale then
    tgsGender.State := tssOn
  else
    tgsGender.State := tssOff;

  setEditorWarn(0);
end;

end.
